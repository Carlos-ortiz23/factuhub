# =============================================================================
# FactuHub — local environment template
#
# Setup:
#     cp env.example .env
#     # then replace every "change-me" value
#
# `.env` is git-ignored and must NEVER be committed. The tooling that guards
# this repository also denies reading/writing `.env*` files, so treat this
# template as the single documented source of configuration keys.
# =============================================================================

# --- Application -------------------------------------------------------------
# development | test | production
APP_ENV=development
APP_DEBUG=true
# Generated with: openssl rand -hex 32
APP_SECRET_KEY=change-me-run-openssl-rand-hex-32
APP_ALLOWED_HOSTS=localhost,127.0.0.1

# --- Sessions ----------------------------------------------------------------
# Lifetime of an issued session. One working day plus margin.
SESSION_TTL_HOURS=12
SESSION_COOKIE_NAME=factuhub_session
# Leave commented to derive it: Secure in production, not Secure in local
# development (a Secure cookie over plain HTTP would simply never be sent, and
# the bug looks like a broken login).
# SESSION_COOKIE_SECURE=true

# --- Database ----------------------------------------------------------------
# Development database (docker compose service: postgres, host port 5432)
POSTGRES_USER=factuhub
POSTGRES_PASSWORD=change-me
POSTGRES_DB=factuhub_dev
POSTGRES_PORT=5432

# Isolated database used by the automated test suite (host port 5433).
# Tests never touch the development database.
POSTGRES_TEST_USER=factuhub_test
POSTGRES_TEST_PASSWORD=change-me-too
POSTGRES_TEST_DB=factuhub_test
POSTGRES_TEST_PORT=5433

# SQLAlchemy URLs. The application reads DATABASE_URL, the test suite reads
# TEST_DATABASE_URL.
DATABASE_URL=postgresql+psycopg://factuhub:change-me@localhost:5432/factuhub_dev
TEST_DATABASE_URL=postgresql+psycopg://factuhub_test:change-me-too@localhost:5433/factuhub_test

# --- Frontend ----------------------------------------------------------------
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# --- Accounting providers ----------------------------------------------------
# No provider credentials live here. Each company connects its own accounting
# system from Configuración, and those credentials are stored per organization,
# encrypted, and never returned to the frontend (specification §11.3). A token
# in this file would be the platform's, not the company's.

# --- Object storage ----------------------------------------------------------
# Optional for the MVP: when unset, imported files live on the private local
# filesystem path below instead of an S3-compatible bucket.
S3_ENDPOINT_URL=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
LOCAL_STORAGE_PATH=backend/var/storage
